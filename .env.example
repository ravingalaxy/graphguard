# GraphGuard Configuration Template
# Copy this file to .env to customize settings

# Application Server
PORT=8000
HOST=0.0.0.0

# FalkorDB Database (Default: localhost:6379, or 'falkordb' in Docker)
FALKOR_HOST=localhost
FALKOR_PORT=6379

# FalkorDB Cloud Credentials (Optional - leave empty for local Docker / Fallback mode)
# Get a free cloud database at: https://app.falkordb.cloud
FALKOR_PASSWORD=
FALKOR_USERNAME=
